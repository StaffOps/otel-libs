<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The helper: by default the project in this tree (dotnet run from the repo).
    The Dockerfiles pass -p:OtelHelperVersion=<version> and restore the packed
    StaffOps.OtelHelper .nupkg from a local feed (../nuget.packages.config), as
    a consumer does (task C17).
  -->
  <ItemGroup Condition="'$(OtelHelperVersion)' == ''">
    <ProjectReference Include="..\..\StaffOps.OtelHelper\StaffOps.OtelHelper.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OtelHelperVersion)' != ''">
    <PackageReference Include="StaffOps.OtelHelper" Version="$(OtelHelperVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\order.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
