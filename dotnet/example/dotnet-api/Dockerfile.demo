# What CI builds (example-images): the prebuilt StaffOps.OtelHelper packages of
# this commit (build-lib artifact, downloaded to dotnet/packages/), restored from
# the local feed /packages (example/nuget.packages.config), never a project reference.
#   docker build -t dotnet-api -f dotnet/example/dotnet-api/Dockerfile.demo dotnet   # after packing into dotnet/packages/
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Prebuilt StaffOps.OtelHelper package (built once in CI, passed via artifact)
COPY packages/ /packages/
COPY Directory.Build.props Directory.Build.targets ./
COPY example/nuget.packages.config example/
COPY example/Protos/ example/Protos/
COPY example/dotnet-api/dotnet-api.csproj example/dotnet-api/
# Exactly one core package (StaffOps.OtelHelper.<version>.nupkg): its version is
# passed as OtelHelperVersion, which switches the csproj to a PackageReference.
RUN set -- /packages/StaffOps.OtelHelper.[0-9]*.nupkg && \
    if [ $# -ne 1 ] || [ ! -f "$1" ]; then echo "expected exactly one StaffOps.OtelHelper.<version>.nupkg in /packages, found: $*" >&2; exit 1; fi && \
    ver=$(basename "$1" .nupkg | sed 's/^StaffOps\.OtelHelper\.//') && echo "$ver" > /tmp/helper-version && \
    dotnet restore example/dotnet-api/dotnet-api.csproj --configfile example/nuget.packages.config -p:OtelHelperVersion="$ver"
COPY example/dotnet-api/ example/dotnet-api/
RUN dotnet publish example/dotnet-api/dotnet-api.csproj -c Release --no-restore \
    -p:OtelHelperVersion="$(cat /tmp/helper-version)" -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "dotnet-api.dll"]
