<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for the example Dockerfiles and the e2e scripts (task C17): the
  StaffOps.OtelHelper* packages come ONLY from the local feed /packages (packed
  from this tree in a build stage, or the CI artifact for Dockerfile.demo);
  everything else from nuget.org. The mapping keeps a same-version package on
  another feed from replacing the one just packed.
    dotnet restore <csproj> -configfile example/nuget.packages.config -p:OtelHelperVersion=<version>
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="StaffOps.OtelHelper" />
      <package pattern="StaffOps.OtelHelper.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
