<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Parity fixture driver (design D-NET12): runs ONE case of parity/cases.json
    in its own process and prints one JSON snapshot on stdout. Spawned by
    ParityTests from the test output folder, so the instrumented helper
    assemblies run here and coverlet merges their hits. Not a shipped package.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as dotnet/example; no Grpc.Tools, the test service uses raw marshallers. -->
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.62.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StaffOps.OtelHelper\StaffOps.OtelHelper.csproj" />
  </ItemGroup>
</Project>
