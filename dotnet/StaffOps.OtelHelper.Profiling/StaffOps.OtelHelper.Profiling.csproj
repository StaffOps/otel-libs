<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <PackageId>StaffOps.OtelHelper.Profiling</PackageId>
    <Version>0.2.0</Version>
    <Description>Continuous profiling add-on for StaffOps.OtelHelper (Pyroscope in-process)</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StaffOps.OtelHelper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StaffOps.OtelHelper\StaffOps.OtelHelper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Pyroscope" Version="1.2.0" />
    <PackageReference Include="Pyroscope.OpenTelemetry" Version="0.5.0" />
  </ItemGroup>
</Project>
