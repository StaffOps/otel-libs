    "@staffops/otel-helper": "0.3.0-rc.1",
    "@staffops/otel-helper-pino": "0.3.0-rc.1",
    "@staffops/otel-helper-redis": "0.3.0-rc.1",
    "@staffops/otel-helper-sql": "0.3.0-rc.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "redis": "6.2.1"
  }
}
