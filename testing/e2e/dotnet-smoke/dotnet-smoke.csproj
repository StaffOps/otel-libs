<Project Sdk="Microsoft.NET.Sdk">
  <!--
    .NET smoke program (task C17). It consumes the StaffOps.OtelHelper package
    that run-dotnet.sh packs from this tree into a local feed, never a project
    reference: the e2e checks the package a consumer restores.
    OtelHelperVersion is passed by run-dotnet.sh (-p:OtelHelperVersion=...).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1801;NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StaffOps.OtelHelper" Version="$(OtelHelperVersion)" />
  </ItemGroup>
</Project>
