FROM python:3.11-slim


WORKDIR /app

# Install prebuilt staffops-otel-helper wheel (built once in CI, passed via artifact)
COPY packages/staffops_otel_helper-*.whl /tmp/
RUN pip install --no-cache-dir /tmp/staffops_otel_helper-*.whl

# Install app dependencies (skip staffops-otel-helper line — already installed from wheel)
COPY example/python-process/requirements.txt .
RUN grep -v "staffops-otel-helper\|setuptools" requirements.txt | pip install --no-cache-dir -r /dev/stdin

COPY example/python-process/ /app/

CMD ["python", "workers.py"]
