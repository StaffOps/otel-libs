# Top-level dependencies of the Python demo apps (specs/demo-environment DE3b).
# requirements.lock is generated from this file by lock.sh (Docker, pip-tools,
# hashes): exact pins belong in demo lockfiles only (AGENTS.md Packaging).
#
# The helper itself comes from the local tree (python/), installed with
# --no-deps after the lock; its own dependencies are resolved into the lock
# through the line below, which lock.sh then removes from the output.
staffops-otel-helper[redis,sql] @ file:///work/python

fastapi>=0.115,<1
uvicorn>=0.30,<1
httpx>=0.27,<1
pydantic>=2.8,<3
grpcio>=1.76,<2
grpcio-health-checking>=1.76,<2
# Build stage only (stub generation), removed from the runtime image.
grpcio-tools>=1.76,<2
# Build stage only: the helper's build backend, pinned and hashed so the local
# helper installs with --no-build-isolation (nothing fetched outside the lock).
hatchling>=1.27,<2
# googleapis-common-protos (pulled by the OTLP exporters) needs protobuf >= 6.33.5
# (see python/example/python-api/requirements.txt).
protobuf>=6.33.5,<7
redis>=5.0,<7
# The contrib SQLAlchemy instrumentation supports < 2.1 (P18).
sqlalchemy>=2.0.31,<2.1
# DE-D4: SQLAlchemy 2 + psycopg 3. LGPL-3.0, dynamically loaded; binary wheel so the
# slim image needs no libpq.
psycopg[binary]>=3.2,<4
