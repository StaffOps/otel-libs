          "limit": 20,
          "metricsQueryType": "range",
          "query": "{ resource.service.name =~ \"demo-(${lang:pipe})-(api|backend|worker)\" && resource.service.name =~ \"${service:pipe}\" && kind = server && (statusMessage != \"\" || event.exception.message != nil || event.exception.stacktrace != nil) } | count_over_time()",
          "queryType": "traceql",
