          "expr": "sum by (lang) (label_replace(rate(traces_span_metrics_calls_total{service_name=~\"demo-(${lang:pipe})-(api|backend|worker)\", service_name=~\"${service:pipe}\", service_name=~\"demo-.*-api\", span_kind=\"SPAN_KIND_SERVER\"}[5m]), \"lang\", \"$1\", \"service_name\", \"demo-([a-z]+)-.*\"))",
          "instant": true,
          "legendFormat": "{{lang}}",
